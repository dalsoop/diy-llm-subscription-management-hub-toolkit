{
  "name": "diy-llm-subscription-management-hub-toolkit",
  "version": "1.0.0",
  "description": "Universal DIY LLM subscription & session management hub — proxy router, quota tracker, and menu bar dashboard",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "opencodex:start": "bun run --cwd packages/opencodex src/cli/index.ts start --port 10100",
    "opencodex:test": "bun test --cwd packages/opencodex",
    "codexbar:build": "swift build --package-path apps/codexbar -c release",
    "codexbar:test": "make -C apps/codexbar test",
    "codexbar:check": "make -C apps/codexbar check"
  },
  "license": "MIT"
}
